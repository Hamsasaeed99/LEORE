@using LEORE.Data

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LEORÉ</title>
    <script type="importmap"></script>
     <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" asp-append-version="true">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="/css/style.css" asp-append-version="true" />
     <link rel="stylesheet" href="/css/styles.css" asp-append-version="true">
</head>
<body>
    <header class="header">
        <div class="header-container">
            <div class="logo">
                <img src="/images/Home/logo without background.png" alt="LEORÉ logo" />
            </div>
            <div class="search-bar">
                <input type="text"
                       placeholder="Tap to search......"
                       class="search-input" />
                <button type="button" class="search-button" aria-label="Search">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            <nav class="nav-menu">
                <a asp-controller="Home" asp-action="Index" class="nav-link home">Home</a>
                <div class="dropdown">
                    <a asp-controller="Product" asp-action="Index" class="nav-link shop-link">Shop</a>
                    <div class="dropdown-content">

                        @await Component.InvokeAsync("Categories")

                    </div>
                </div>
                <a asp-controller="Home" asp-action="About" class="nav-link">About</a>
                <a asp-controller="Home" asp-action="Contact" class="nav-link">Contact</a>
            </nav>
            <div class="header-actions">
                @{
                    var userId = Context.Session.GetInt32("UserId");
                }
                @if (userId != null)
                {
                    <!-- مسجل دخول - عرض زرين -->
                    <a asp-controller="User" asp-action="Index" class="nav-link profile-link">Profile</a>


                    <a asp-controller="Cart" asp-action="MyCart" class="nav-link cart-icon">
                        <i class="fas fa-shopping-cart"></i>
                    </a>
                    
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="profile-text">
                        <i class="fas fa-sign-in-alt1"></i> Login
                    </a>
                }
                    
                </a>
            </div>
        </div>
    </header>
