@model IEnumerable<LEORE.Models.Cart>

@{
    ViewData["Title"] = "MyCart";
}
<main class="main-content">
    <section class="cart-card">
        <h1 class="page-title">Your Cart</h1>

        <div class="products-section">
            <h2 class="section-heading">Your Products</h2>

            <article class="product-row" data-price="120">
                <div class="product-thumb"></div>
                <div class="product-info">
                    <div class="product-name">product name</div>
                    <div class="price-chip">
                        <span class="price-value">$120.00</span>
                    </div>
                </div>
                <div class="quantity">
                    <button class="qty-btn">-</button>
                    <span class="qty-value">1</span>
                    <button class="qty-btn">+</button>
                </div>
                <button class="remove-btn"
                        aria-label="Remove item">
                    x
                </button>
            </article>

            <article class="product-row" data-price="95">
                <div class="product-thumb"></div>
                <div class="product-info">
                    <div class="product-name">product name</div>
                    <div class="price-chip">
                        <span class="price-value">$95.00</span>
                    </div>
                </div>
                <div class="quantity">
                    <button class="qty-btn">-</button>
                    <span class="qty-value">1</span>
                    <button class="qty-btn">+</button>
                </div>
                <button class="remove-btn"
                        aria-label="Remove item">
                    x
                </button>
            </article>
        </div>

        <div class="order-summary">
            <h2 class="section-heading">Order Summary</h2>

            <div class="summary-row">
                <span>Subtotal</span>
                <span class="subtotal-value">$0.00</span>
            </div>

            <div class="summary-row shipping-row">
                <span>Shipping</span>
                <span class="muted">Calculated At Checkout</span>
            </div>

            <div class="promo-row">
                <input type="text" placeholder="Calculated At Checkout"
                       class="promo-input">
                <button class="apply-btn">Apply</button>
            </div>

            <div class="summary-row total-row">
                <span>Total</span>
                <span class="total-value">$0.00</span>
            </div>

            <button class="primary-btn">CheckOut</button>
            <button class="secondary-btn">Continue Shopping</button>
        </div>

    </section>
</main>
