@model IEnumerable<LEORE.Models.Product>

@{
    ViewData["Title"] = "Index";
}

<div>
    <main class="main-content">

            <div class="product-container">
            @foreach (var item in Model)
            {
                <div class="product-card">
                    <div class="product-image-container">
                        <i class="far fa-heart wishlist-icon"></i>
                         <a asp-action="Details"
                          asp-route-id="@item.ProductID"
                          class="product-link">
                        <img src="@item.Image" width="150" asp-action="Details" asp-route-id="@item.ProductID"/>
                        </a>
                    </div>
                    <div class="product-details">
                        <h3 class="product-name">@item.Name</h3>
                        <div class="rating">
                            @for (int i = 0; i < item.Rate; i++)
                            {
                                <i class="fas fa-star"></i>
                            }
                            @for (int i = 0; i < 5-item.Rate; i++)
                            {
                                <i class="far fa-star"></i>
                            }

                        </div>
                        <p class="price">@item.Price $</p>
                        <button class="add-to-cart-btn"data-product-id="@item.ProductID">Add to cart</button>
                    </div>
                </div>
            }

            </div>
            
        </main>

</div>

